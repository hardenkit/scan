{
  "mcpServers": {
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      }
    },
    "search": {
      "command": "uvx",
      "args": ["acme-search-mcp==0.3.1"],
      "env": {
        "OPENAI_API_KEY": "sk-proj-hardenkit-test-fixture-not-a-real-key"
      }
    },
    "docs": {
      "url": "http://docs-mcp.internal.example.com/sse"
    },
    "tools": {
      "command": "docker",
      "args": ["run", "-i", "--rm", "--privileged", "ghcr.io/acme/tools-mcp:latest"]
    }
  }
}
